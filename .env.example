# Copy to .env and edit. Never commit the real file.
PORT=3000
# Required in production (64+ random hex chars). In dev a random one is made per run.
APP_SECRET=
# Public base URL used inside report links
BASE_URL=http://localhost:3000
# Folder the LIS drops CSV exports into
LIS_EXPORT_DIR=./lis-export
# 1 = show OTPs and the message outbox in the UI. NEVER set in production.
DEMO_MODE=0
# Optional: enables AI summaries for tests outside the locked templates
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
